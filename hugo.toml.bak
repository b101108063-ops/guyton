baseURL = 'https://github.com/b101108063-ops/guyton-notes'
locale = 'en-us'
theme = 'PaperMod'

[frontmatter]
date = ["date", "publishDate", "lastmod"]

[markup.goldmark.parser.attribute]
title = true

[menu]
  [[menu.main]]
    identifier = "home"
    name = "首頁"
    url = "/"
    weight = 5

  [[menu.main]]
    identifier = "guyton"
    name = "Guyton 選單"
    url = "/guyton/"
    weight = 10

  [[menu.main]]
    identifier = "tintinalli"
    name = "Tintinalli 選單"
    url = "/tintinalli/"
    weight = 20

  [[menu.main]]
    identifier = "huppert"
    name = "Huppert 選單"
    url = "/huppert/"
    weight = 30

  [[menu.main]]
    identifier = "search"
    name = "搜尋"
    url = "/search/"
    weight = 40

[outputs]
  home = ["HTML", "RSS", "JSON"]

[outputFormats.JSON]
  mediatype = "application/json"
  baseName = "index"
  isPlainText = true
  riqueza = true
